# ADMIN CHECK DECORATOR
# =========================
def admin_only(func):
    def wrapper(message):
        if not is_admin(message.from_user.id):
            bot.send_message(message.chat.id, "⛔ ይህ ትዕዛዝ ለአስተዳዳሪዎች ብቻ ነው።")
            return
        return func(message)
    return wrapper

