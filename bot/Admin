from telegram import Update
from telegram.ext import ContextTypes

from config import Config

from database.database import Database
from services.report_service import ReportService



db = Database()

report_service = ReportService()



# =========================
# ADMIN CHECK
# =========================

def is_admin(user_id):

    return user_id in Config.ADMIN_IDS





# =========================
# DASHBOARD
# =========================


async def dashboard(
        update: Update,
        context: ContextTypes.DEFAULT_TYPE
):


    user_id = update.effective_user.id



    if not is_admin(user_id):

        await update.message.reply_text(
            "❌ ይህን ትዕዛዝ ለመጠቀም ፈቃድ የለዎትም"
        )

        return



    data = report_service.dashboard()



    message = f"""

📊 የውሃ ቢሊንግ Dashboard


👥 ጠቅላላ ደንበኞች:
{data['total_customers']}


🟢 Active:
{data['active_customers']}


🧾 ጠቅላላ ቢሎች:
{data['total_bills']}


💰 ገቢ:
{data['total_income']} Birr


⚠️ ያልተከፈለ:
{data['unpaid_amount']} Birr

"""


    await update.message.reply_text(
        message
    )





# =========================
# BACKUP DATABASE
# =========================


async def backup(
        update: Update,
        context: ContextTypes.DEFAULT_TYPE
):


    user_id = update.effective_user.id



    if not is_admin(user_id):

        await update.message.reply_text(
            "❌ Permission Denied"
        )

        return



    try:


        result = db.create_backup()



        if result["success"]:


            await update.message.reply_text(

                f"""
✅ Backup Completed

📁 File:

{result['file']}
"""

            )


        else:


            await update.message.reply_text(
                "❌ Backup Failed"
            )



    except Exception as e:


        await update.message.reply_text(

            f"Error: {e}"

        )







# =========================
# USERS LIST
# =========================


async def users(
        update: Update,
        context: ContextTypes.DEFAULT_TYPE
):


    user_id = update.effective_user.id



    if not is_admin(user_id):


        await update.message.reply_text(
            "❌ Permission Denied"
        )


        return





    conn = db.connect()

    cursor = conn.cursor()



    cursor.execute("""

    SELECT

    username,

    full_name,

    role,

    status

    FROM users

    ORDER BY id DESC

    """)



    result = cursor.fetchall()



    conn.close()



    if not result:


        await update.message.reply_text(

            "User አልተገኘም"

        )

        return





    text = "👤 Users List\n\n"



    for user in result:


        text += f"""

Username:
{user['username']}

Name:
{user['full_name']}

Role:
{user['role']}

Status:
{user['status']}

----------------

"""



    await update.message.reply_text(
        text
    )
