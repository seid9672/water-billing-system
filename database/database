# Water Billing System - Database Version 5.3

import sqlite3
import os
import shutil
from datetime import datetime
from config import Config

class Database:
    def __init__(self):
        self.db_path = Config.DATABASE_NAME
        folder = os.path.dirname(self.db_path)
        if folder:
            os.makedirs(folder, exist_ok=True)
        # initialize_database() አሁን በ main.py ውስጥ ይጠራል

    def connect(self):
        conn = sqlite3.connect(self.db_path, timeout=30)
        conn.row_factory = sqlite3.Row
        conn.execute("PRAGMA foreign_keys = ON")
        conn.execute("PRAGMA journal_mode=WAL")
        conn.execute("PRAGMA synchronous=NORMAL")
        return conn

    def initialize_database(self):
        self.create_tables()
        self.insert_default_tariff()

    def create_tables(self):
        conn = self.connect()
        cursor = conn.cursor()
        try:
            # USERS
            cursor.execute("""
                CREATE TABLE IF NOT EXISTS users(
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    username TEXT UNIQUE NOT NULL,
                    password_hash TEXT NOT NULL,
                    full_name TEXT,
                    phone TEXT,
                    role TEXT DEFAULT 'employee',
                    status TEXT DEFAULT 'active',
                    created_at TEXT DEFAULT CURRENT_TIMESTAMP
                )
            """)
            # CUSTOMERS
            cursor.execute("""
                CREATE TABLE IF NOT EXISTS customers(
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    customer_code TEXT UNIQUE,
                    name TEXT NOT NULL,
                    phone TEXT,
                    category TEXT DEFAULT 'PR',
                    block TEXT,
                    zone TEXT,
                    house_number TEXT,
                    address TEXT,
                    meter_number TEXT UNIQUE,
                    meter_size TEXT,
                    connection_type TEXT,
                    status TEXT DEFAULT 'active',
                    created_at TEXT DEFAULT CURRENT_TIMESTAMP
                )
            """)
            # METER READINGS
            cursor.execute("""
                CREATE TABLE IF NOT EXISTS meter_readings(
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    customer_id INTEGER NOT NULL,
                    previous_reading REAL DEFAULT 0,
                    current_reading REAL DEFAULT 0,
                    consumption REAL DEFAULT 0,
                    approved INTEGER DEFAULT 0,
                    reading_date TEXT DEFAULT CURRENT_TIMESTAMP,
                    entered_by INTEGER,
                    FOREIGN KEY(customer_id) REFERENCES customers(id) ON DELETE CASCADE,
                    FOREIGN KEY(entered_by) REFERENCES users(id)
                )
            """)
            # BILLS
            cursor.execute("""
                CREATE TABLE IF NOT EXISTS bills(
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    customer_id INTEGER NOT NULL,
                    reading_id INTEGER UNIQUE,
                    invoice_number TEXT UNIQUE,
                    previous_reading REAL DEFAULT 0,
                    current_reading REAL DEFAULT 0,
                    consumption REAL DEFAULT 0,
                    amount REAL DEFAULT 0,
                    status TEXT DEFAULT 'unpaid',
                    created_at TEXT DEFAULT CURRENT_TIMESTAMP,
                    FOREIGN KEY(customer_id) REFERENCES customers(id) ON DELETE CASCADE,
                    FOREIGN KEY(reading_id) REFERENCES meter_readings(id)
                )
            """)
            # PAYMENTS
            cursor.execute("""
                CREATE TABLE IF NOT EXISTS payments(
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    customer_id INTEGER NOT NULL,
                    bill_id INTEGER,
                    amount REAL NOT NULL,
                    payment_method TEXT DEFAULT 'cash',
                    reference_no TEXT,
                    paid_by TEXT,
                    payment_date TEXT DEFAULT CURRENT_TIMESTAMP,
                    FOREIGN KEY(customer_id) REFERENCES customers(id),
                    FOREIGN KEY(bill_id) REFERENCES bills(id)
                )
            """)
            # TARIFF
            cursor.execute("""
                CREATE TABLE IF NOT EXISTS tariffs(
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    category TEXT NOT NULL,
                    min_unit REAL NOT NULL,
                    max_unit REAL NOT NULL,
                    price REAL NOT NULL,
                    effective_date TEXT DEFAULT CURRENT_TIMESTAMP
                )
            """)
            # AUDIT LOG
            cursor.execute("""
                CREATE TABLE IF NOT EXISTS audit_logs(
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    user_id INTEGER,
                    action TEXT,
                    table_name TEXT,
                    record_id INTEGER,
                    description TEXT,
                    created_at TEXT DEFAULT CURRENT_TIMESTAMP,
                    FOREIGN KEY(user_id) REFERENCES users(id)
                )
            """)
            # BACKUP HISTORY
            cursor.execute("""
                CREATE TABLE IF NOT EXISTS backup_history(
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    filename TEXT NOT NULL,
                    filepath TEXT NOT NULL,
                    size INTEGER,
                    created_at TEXT DEFAULT CURRENT_TIMESTAMP
                )
            """)
            # INDEXES
            cursor.execute("CREATE INDEX IF NOT EXISTS idx_customer_code ON customers(customer_code)")
            cursor.execute("CREATE INDEX IF NOT EXISTS idx_meter_number ON customers(meter_number)")
            cursor.execute("CREATE INDEX IF NOT EXISTS idx_customer_phone ON customers(phone)")
            cursor.execute("CREATE INDEX IF NOT EXISTS idx_reading_customer ON meter_readings(customer_id)")
            cursor.execute("CREATE INDEX IF NOT EXISTS idx_bill_customer ON bills(customer_id)")
            cursor.execute("CREATE INDEX IF NOT EXISTS idx_invoice_number ON bills(invoice_number)")
            cursor.execute("CREATE INDEX IF NOT EXISTS idx_payment_customer ON payments(customer_id)")

            conn.commit()
            print("✅ All tables created successfully")
        except Exception as e:
            conn.rollback()
            print("Database Create Error:", e)
            raise e
        finally:
            conn.close()

    def insert_default_tariff(self):
        conn = self.connect()
        cursor = conn.cursor()
        try:
            cursor.execute("SELECT COUNT(*) FROM tariffs")
            count = cursor.fetchone()[0]
            if count == 0:
                tariffs = [
                    ("PR", 0, 5, 25), ("PR", 5, 10, 27), ("PR", 10, 15, 28.5),
                    ("PR", 15, 25, 30), ("PR", 25, 999999, 32),
                    ("COM", 0, 5, 30), ("COM", 5, 10, 32), ("COM", 10, 15, 33.5),
                    ("COM", 15, 25, 35), ("COM", 25, 999999, 36.5),
                    ("PUB", 0, 5, 29), ("PUB", 5, 10, 30), ("PUB", 10, 15, 32),
                    ("PUB", 15, 25, 33.5), ("PUB", 25, 999999, 35),
                ]
                cursor.executemany("""
                    INSERT INTO tariffs(category, min_unit, max_unit, price)
                    VALUES(?,?,?,?)
                """, tariffs)
                conn.commit()
                print("✅ All tariffs (PR, COM, PUB) inserted successfully")
            else:
                print(f"ℹ️ Tariffs already exist ({count} records)")
        except Exception as e:
            conn.rollback()
            print("Tariff Error:", e)
        finally:
            conn.close()

    def check_database(self):
        try:
            conn = self.connect()
            conn.execute("SELECT 1")
            conn.close()
            return True
        except Exception as e:
            print("Database Error:", e)
            return False

    def generate_customer_code(self):
        conn = self.connect()
        cursor = conn.cursor()
        cursor.execute("SELECT COUNT(*) FROM customers")
        count = cursor.fetchone()[0]
        conn.close()
        number = count + 1
        return f"{Config.CUSTOMER_CODE_PREFIX}-{number:06d}"

    def create_backup(self):
        filename = f"water_backup_{datetime.now().strftime('%Y%m%d_%H%M%S')}.db"
        path = os.path.join(Config.BACKUP_FOLDER, filename)
        shutil.copy2(self.db_path, path)
        size = os.path.getsize(path)
        conn = self.connect()
        cursor = conn.cursor()
        cursor.execute("""
            INSERT INTO backup_history (filename, filepath, size)
            VALUES (?, ?, ?)
        """, (filename, path, size))
        conn.commit()
        conn.close()
        return {"success": True, "file": path}

    def restore_backup(self, backup_file):
        if not os.path.exists(backup_file):
            return {"success": False, "error": "Backup file not found"}
        shutil.copy2(backup_file, self.db_path)
        return {"success": True, "message": "Database restored"}

    def get_backup_history(self, limit=10):
        conn = self.connect()
        cursor = conn.cursor()
        cursor.execute("""
            SELECT * FROM backup_history
            ORDER BY created_at DESC LIMIT ?
        """, (limit,))
        history = cursor.fetchall()
        conn.close()
        return history

    def summary(self):
        conn = self.connect()
        cursor = conn.cursor()
        result = {}
        tables = ["customers", "bills", "payments", "users"]
        for table in tables:
            cursor.execute(f"SELECT COUNT(*) FROM {table}")
            result[table] = cursor.fetchone()[0]
        conn.close()
        return result
